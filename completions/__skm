(( $+functions[__skm_commands] )) ||
__skm_commands() {
    local commands; commands=(
'init:Set up the skill store and project config (\`.skm.toml\`)' \
'import:Import a skill directory into the library' \
'add:Import a skill directory into the library' \
'profile:Create and manage profiles' \
'skill:Manage skills in the library' \
'use-profile:Activate a profile and sync skill links' \
'switch-agent:Change the target agent in your config' \
'sync:Refresh skill links without changing the active profile' \
'status:Show the target agent, active profile, linked skills, and placement conflicts' \
'ls:List skills and profiles in the store' \
'scan:Refresh the on-disk skill index' \
'doctor:Read-only health report for the store, profiles, and skill links' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands '_skm commands' commands "$@"
}
(( $+functions[_skm__subcmd__doctor_commands] )) ||
_skm__subcmd__doctor_commands() {
    local commands; commands=()
    _describe -t commands 'skm doctor commands' commands "$@"
}
